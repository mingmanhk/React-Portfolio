# Copy to .env.production.local (git-ignored) or set in the deploy environment.

# Canonical site URL used for sitemap.xml and robots.txt.
VITE_SITE_URL=https://mingmanhk.github.io/React-Portfolio

# GoatCounter site code (the "CODE" in https://CODE.goatcounter.com).
# Leave empty to build without analytics. The CSP allows GoatCounter only when this is set.
VITE_GOATCOUNTER_CODE=

# Google Search Console HTML-tag verification code (content="..." value only).
VITE_GOOGLE_SITE_VERIFICATION=
