{
  "name": "react-portfolio",
  "version": "2.0.0",
  "private": true,
  "dependencies": {
    "@fontsource-variable/public-sans": "^5.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "playwright-core": "^1.64.0",
    "vite": "^8.3.4"
  },
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build && vite build --ssr src/entry-server.jsx --outDir build-ssr && node scripts/prerender.mjs && node scripts/generate-sitemap.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "npm run lint && npm run build && npm run check",
    "lint:fix": "eslint . --fix",
    "resume:pdf": "node scripts/build-resume-pdf.mjs",
    "check": "node scripts/check-site.mjs"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "type": "module",
  "engines": {
    "node": ">=20.19"
  }
}
